{
  "name": "tales-of-the-blaue-adria",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:redesign": "vite --config vite.redesign.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && vite build --outDir docs/next --emptyOutDir",
    "build:redesign": "vite build --config vite.redesign.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:legacy": "node scripts/validate-legacy.mjs",
    "validate:next": "node scripts/validate-next.mjs",
    "validate:redesign": "node scripts/validate-redesign.mjs",
    "check": "npm run validate:legacy && npm run typecheck && npm run test && npm run build && npm run build:preview && npm run validate:next && npm run build:redesign && npm run validate:redesign"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "8.1.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
