{
  "name": "tales-of-the-blaue-adria",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:redesign": "vite --config vite.redesign.config.ts",
    "dev:lpc-test": "vite --config vite.lpc-test.config.ts",
    "dev:lpc-main": "vite --config vite.lpc-main.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && vite build --outDir docs/next --emptyOutDir",
    "build:redesign": "vite build --config vite.redesign.config.ts",
    "build:lpc-test": "vite build --config vite.lpc-test.config.ts",
    "build:lpc-main": "vite build --config vite.lpc-main.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:legacy": "node scripts/validate-legacy.mjs",
    "validate:next": "node scripts/validate-next.mjs",
    "validate:redesign": "node scripts/validate-redesign.mjs",
    "validate:lpc-test": "node scripts/validate-lpc-test.mjs",
    "validate:lpc-main": "node scripts/validate-lpc-main.mjs",
    "validate:depth": "node scripts/validate-depth-update.mjs",
    "validate:graphics": "node scripts/validate-graphics-update.mjs",
    "smoke:lpc-main": "node scripts/smoke-lpc-main-browser.mjs",
    "smoke:depth": "node scripts/smoke-depth-update-browser.mjs",
    "smoke:graphics": "node scripts/smoke-graphics-update-browser.mjs",
    "smoke:beer-pong": "node scripts/smoke-beer-pong-browser.mjs",
    "smoke:battle-league": "node scripts/smoke-battle-league-browser.mjs",
    "smoke:opening": "node scripts/smoke-opening-sequence-browser.mjs",
    "smoke:progression": "node scripts/smoke-progression-flow-browser.mjs",
    "check": "npm run validate:legacy && npm run typecheck && npm run test && npm run validate:depth && npm run validate:graphics && npm run build && npm run build:preview && npm run validate:next && npm run build:redesign && npm run validate:redesign && npm run build:lpc-test && npm run validate:lpc-test && npm run build:lpc-main && npm run validate:lpc-main && npm run smoke:lpc-main && npm run smoke:depth && npm run smoke:graphics && npm run smoke:beer-pong && npm run smoke:battle-league && npm run smoke:opening && npm run smoke:progression"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "8.1.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}